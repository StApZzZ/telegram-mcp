# `server.py init` writes this file for you. By hand: copy to ~/.config/telegram-mcp/.env and chmod 600.

# Application credentials: create an app at https://my.telegram.org/apps (any name; platform "Desktop").
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Where `server.py login` stores the session. It is a full login to your account: keep it private.
TELEGRAM_SESSION=~/.config/telegram-mcp/telegram.session
# Rate limits Telegram imposes shorter than this are waited out; longer ones fail the call.
TELEGRAM_FLOOD_WAIT_MAX_SEC=10

# true: no tool that sends, edits, reacts, marks read or downloads is offered at all.
TELEGRAM_READ_ONLY=false
# Comma-separated writing tools that Claude Code asks you about on every call, in every permission mode,
# or "none". Choose from send_message, edit_message, react, mark_read, download_file.
TELEGRAM_CONFIRM_TOOLS=send_message,edit_message,react

# Where download_file saves files; saving outside this directory is refused.
TELEGRAM_DOWNLOADS_DIR=~/Downloads/telegram
# Largest file download_file will save, in MB.
TELEGRAM_MAX_DOWNLOAD_MB=100
# ":"-separated directories send_message may attach files from (default: home and the downloads dir).
# Hidden paths (~/.ssh, ~/.config, ...) and key or session files (*.session, *.pem, *.key, ...) are always refused.
TELEGRAM_UPLOAD_DIRS=

# Only for --http. Generate with: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
TELEGRAM_MCP_TOKEN=
TELEGRAM_MCP_HOST=127.0.0.1
TELEGRAM_MCP_PORT=8733
